---
/*
  /mentions-legales : page legale, fond clair, largeur de lecture 720px.
  Reutilise le design system via Base (header variante claire, footer).
  robots noindex,follow : page utile aux visiteurs mais pas destinee a
  l'indexation. Les informations inconnues restent en PLACEHOLDER visible
  et doivent etre remplacees avant mise en ligne definitive.
*/
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { SITE_DATA } from '../data/site.ts';
import { getLang, useTranslations } from '../i18n';

// Textes : src/i18n/<langue>.ts, cle `legal.mentions`. Le corps de la page est
// stocke en HTML dans le dictionnaire et rendu via set:html : la structure
// des sections reste identique d'une langue a l'autre.
const dict = useTranslations(getLang(Astro.url));
const g = dict.legal;
const t = g.mentions;

const dateMaj = new Date().toLocaleDateString(dict.common.locale, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base
  title={`${t.metaTitle} | ${SITE_DATA.name}`}
  description={t.metaDescription}
  headerTheme="light"
  noindex={true}
>
  <section
    data-tone="cream"
    class="relative bg-cream py-section text-ink scroll-mt-24"
  >
    <div class="container">
      <div class="mx-auto max-w-[760px]">
        <!-- Fil d'ariane : Accueil > page courante -->
        <nav
          class="fil-ariane"
          aria-label={dict.common.breadcrumbAria}
          data-reveal
        >
          <ol>
            <li><a href={g.homeHref}>{g.breadcrumbHome}</a></li>
            <li aria-hidden="true" class="fil-sep">/</li>
            <li aria-current="page">{t.breadcrumb}</li>
          </ol>
        </nav>

        <header class="mt-8" data-reveal-stagger="120">
          <div data-reveal>
            <Eyebrow tone="light">{t.eyebrow}</Eyebrow>
          </div>
          <h1 class="type-h2 mt-5 text-ink" data-reveal>{t.h1}</h1>
          <p class="type-body mt-6 text-ink-muted" data-reveal>
            {g.updatedPrefix} {dateMaj}.
          </p>
        </header>

        <div class="prose-legal mt-12" data-reveal>
          {
            t.sections.map((section) => (
              <>
                <h2>{section.h2}</h2>
                <Fragment set:html={section.html} />
              </>
            ))
          }
        </div>

        <div class="mt-12 text-center" data-reveal>
          <a
            href={g.homeHref}
            class="type-nav text-ink-muted transition-colors hover:text-gold"
          >
            {g.backHome}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style is:global>
  /* Styles de lecture des pages legales. Largeur 720px, hierarchie Clash
     Display, palette ink / gold / line. Cibles sur .prose-legal pour ne
     jamais deborder sur le reste du site. */
  .prose-legal {
    color: var(--ink-muted);
  }
  .prose-legal p {
    max-width: 720px;
    margin: 1.25rem 0;
    font-family: var(--font-body);
    font-size: 1.075rem;
    line-height: 1.75;
  }
  .prose-legal h2 {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-weight: 600;
    color: var(--ink);
    font-size: clamp(1.35rem, 2.4vw, 1.6rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }
  .prose-legal h2:first-child {
    margin-top: 0;
  }
  .prose-legal ul {
    max-width: 720px;
    margin: 1.25rem 0;
    padding-left: 1.4rem;
  }
  .prose-legal li {
    margin: 0.5rem 0;
    font-family: var(--font-body);
    font-size: 1.075rem;
    line-height: 1.7;
  }
  .prose-legal ul li::marker {
    color: var(--gold);
  }
  .prose-legal strong {
    color: var(--ink);
    font-weight: 600;
  }
  .prose-legal a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: rgba(201, 162, 75, 0.5);
    text-underline-offset: 3px;
    transition: color 200ms var(--ease);
    word-break: break-word;
  }
  .prose-legal a:hover {
    color: var(--gold);
  }
</style>

<style>
  /* Fil d'ariane : liens discrets, separateurs dores. */
  .fil-ariane ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--ink-muted);
  }
  .fil-ariane a {
    color: var(--ink-muted);
    transition: color 200ms var(--ease);
  }
  .fil-ariane a:hover {
    color: var(--gold);
  }
  .fil-ariane [aria-current='page'] {
    color: var(--ink);
  }
  .fil-sep {
    color: var(--gold);
    opacity: 0.7;
  }
</style>
