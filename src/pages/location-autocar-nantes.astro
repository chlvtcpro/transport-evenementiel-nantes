---
/*
  Landing page campagne Google Ads : location de vehicule avec chauffeur.

  Intention de recherche differente de l'accueil. Ici le visiteur cherche a
  LOUER UN VEHICULE AVEC CHAUFFEUR (autocariste Nantes, location minibus
  Nantes, location autocar Nantes), pas un coordinateur d'evenement. Le
  vocabulaire de la page reste donc "location autocar / bus / minibus avec
  chauffeur" et jamais "transport evenementiel".

  Contraintes d'audience issues de la campagne :
    - 83 % du trafic est mobile : tout se concoit mobile d'abord
    - audience majoritairement 45-65 ans : lisibilite, contraste, cibles
      tactiles genereuses, pas d'interaction subtile

  Le hero est ecrit ici et non dans un composant partage : il ne ressemble
  pas au hero de l'accueil et n'a pas vocation a etre reutilise.
*/
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import CallBar from '../components/CallBar.astro';
// Telephone : une seule source, SITE_DATA, pour le lien d'appel comme pour
// l'affichage, ici comme dans la barre d'appel. Le NAP publie ne peut donc
// pas diverger de la fiche Google Business.
import { SITE_DATA, TEL_HREF, TEL_AFFICHE } from '../data/site.ts';

const title = 'Location autocar, bus et minibus avec chauffeur à Nantes';
const description =
  'Location d\'autocar, bus, minibus et van avec chauffeur à Nantes et en Loire-Atlantique. De 3 à 120 places. Devis sous 24h.';

// Ligne de reassurance sous les CTA.
const REASSURANCE = [
  'Devis sous 24h',
  'Chauffeurs professionnels',
  'Nantes et Grand Ouest',
];

/*
  Vehicules mobilisables.

  ATTENTION, contrainte juridique et Google Ads, pas un choix de style :
  aucun vehicule n'est detenu en propre. Le modele est la coordination de
  transporteurs partenaires. Sont donc INTERDITS sur toute la page, y
  compris dans les meta et le JSON-LD : "notre flotte", "nos vehicules",
  "nos chauffeurs", "notre parc". Toute formulation possessive sur le
  materiel ou les conducteurs serait une allegation intenable.

  Formulations utilisables : "vehicules de nos transporteurs partenaires",
  "nous mobilisons", "nous selectionnons le vehicule adapte", "chauffeurs
  professionnels de nos partenaires".

  Aucune photo : montrer un autocar qui n'est pas celui qu'on fournit pose
  exactement le meme probleme que le vocabulaire possessif. La capacite
  porte donc seule la charge visuelle de chaque carte.

  La capacite est composee en trois morceaux pour que seul le nombre soit
  gros : "jusqu'a" + "3" + "passagers" se lit comme une phrase ordinaire,
  mais le 3 seul porte le poids typographique.

  `plage` distingue une fourchette (15 a 22) d'un plafond (3, 8, 120) : la
  premiere occupe six caracteres au lieu d'un a trois et passe donc un cran
  en dessous, sinon la ligne se casse dans la grille a deux colonnes.
*/
const VEHICULES = [
  {
    nom: 'Berline',
    prefixe: 'jusqu\'à',
    nombre: '3',
    plage: false,
    description:
      'Transferts VIP, dirigeants, intervenants. Gare, aéroport, hôtel.',
  },
  {
    nom: 'Van',
    prefixe: 'jusqu\'à',
    nombre: '8',
    plage: false,
    description:
      'Petits groupes, équipes, transferts aéroport Nantes Atlantique.',
  },
  {
    nom: 'Minibus',
    prefixe: 'de',
    nombre: '15 à 22',
    plage: true,
    description:
      'Navettes, séminaires, groupes constitués, rotations sur la journée.',
  },
  {
    nom: 'Autocar',
    prefixe: 'jusqu\'à',
    nombre: '120',
    plage: false,
    description:
      'Grands groupes, congrès, événements d\'entreprise, mariages.',
  },
];

// Villes du signal local. Aucune adresse postale : l'entite est un
// service-area business, exactement comme la fiche Google Business qui
// n'affiche aucune adresse et ne declare que des zones desservies. Le NAP
// publie ici se limite donc au nom et au telephone, a l'identique.
const VILLES_DESSERVIES = [
  'Nantes',
  'Saint-Nazaire',
  'La Baule',
  'Pornic',
  'Carquefou',
  'Vertou',
  'Clisson',
  'Ancenis',
  'Guérande',
];

// JSON-LD propre a la page. Fourni en @graph et rattache au meme @id
// d'entite que le reste du site, pour que les moteurs reconcilient une
// seule entite et non deux.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LocalBusiness',
      '@id': `${SITE_DATA.url}#organization`,
      name: SITE_DATA.name,
      url: SITE_DATA.url,
      description,
      telephone: SITE_DATA.telephone,
      areaServed: [
        { '@type': 'AdministrativeArea', name: 'Loire-Atlantique' },
        ...VILLES_DESSERVIES.map((ville) => ({
          '@type': 'City',
          name: ville,
        })),
      ],
      geo: {
        '@type': 'GeoCoordinates',
        latitude: SITE_DATA.geo.latitude,
        longitude: SITE_DATA.geo.longitude,
      },
      priceRange: SITE_DATA.priceRange,
    },
  ],
};
---

<Base title={title} description={description} jsonLd={jsonLd} headerTheme="dark">
  <!-- 1. HERO : promesse location vehicule avec chauffeur + appel en CTA
       principal. Aucune image de fond, aucun reveal, aucune animation
       d'entree : le trafic est paye, le premier rendu ne doit dependre
       d'aucun telechargement ni d'aucun script. Le LCP est le H1 texte. -->
  <section
    id="hero"
    data-tone="dark"
    class="relative overflow-hidden bg-green-900 text-on-dark"
  >
    <div class="hero-glow absolute inset-0" aria-hidden="true"></div>

    <div class="container relative z-10 pb-14 pt-28 sm:pt-32 lg:pb-24 lg:pt-40">
      <h1 class="hero-title max-w-[16ch]">
        Location d'autocar, bus et minibus avec chauffeur à Nantes
      </h1>

      <p class="hero-subtitle mt-5 max-w-[46ch]">
        De la berline 3 places à l'autocar 120 places. Nantes, Saint-Nazaire
        et toute la Loire-Atlantique.
      </p>

      <!-- CTA. Ordre du DOM = ordre mobile : le bouton d'appel est premier,
           c'est l'action que fait reellement cette audience. -->
      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center sm:gap-4">
        <a
          href={TEL_HREF}
          class="hero-cta-tel"
          aria-label={`Appeler Transport Événementiel Nantes au ${TEL_AFFICHE}`}
        >
          <svg
            class="h-6 w-6 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path
              d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.58 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.4 11.4 0 0 0 .58 3.6 1 1 0 0 1-.25 1Z"
            ></path>
          </svg>
          <span class="hero-cta-tel-number">{TEL_AFFICHE}</span>
        </a>

        <a href="#formulaire-devis" class="hero-cta-devis">
          Demander un devis
        </a>
      </div>

      <ul class="hero-reassurance mt-7">
        {
          REASSURANCE.map((item) => (
            <li>{item}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 2. VEHICULES : berline, van, minibus, autocar, de 3 a 120 passagers.
       Section nommee "vehicules" et non "flotte" : le mot flotte appelle le
       possessif ("notre flotte"), qui est precisement interdit ici. Voir le
       bloc VEHICULES dans le frontmatter. -->
  <Section id="vehicules" tone="cream">
    <p class="type-eyebrow vehicules-eyebrow">Véhicules avec chauffeur</p>

    <h2 class="type-h2 mt-3 max-w-[18ch]">Quel véhicule pour votre groupe ?</h2>

    <!-- Le modele est enonce des la premiere phrase, sans detour. Un
         visiteur qui cherche un autocariste doit savoir tout de suite a qui
         il parle : un coordinateur, pas un depot de bus. -->
    <!-- 68ch et non 52 : a 52 la phrase tombait sur trois lignes en desktop
         avec un "J." orphelin sur la derniere. La contrainte ne joue de
         toute facon pas sous 640px, ou le container est plus etroit. -->
    <p class="vehicules-intro mt-5 max-w-[68ch]">
      Nous mobilisons les véhicules et les chauffeurs professionnels de nos
      transporteurs partenaires. Un seul interlocuteur, du devis au jour J.
    </p>

    <ul class="vehicules-liste mt-10">
      {
        VEHICULES.map((v) => (
          <li class="vehicule">
            <p class="vehicule-capacite">
              <span class="vehicule-prefixe">{v.prefixe}</span>
              <span
                class:list={[
                  'type-stat',
                  'vehicule-nombre',
                  v.plage && 'vehicule-nombre--plage',
                ]}
              >
                {v.nombre}
              </span>
              <span class="vehicule-unite">passagers</span>
            </p>

            <h3 class="vehicule-nom">{v.nom}</h3>
            <p class="vehicule-description">{v.description}</p>
          </li>
        ))
      }
    </ul>

    <!-- Aide au choix. Le visiteur qui hesite entre minibus et autocar est
         exactement celui qui repart sans rien faire : on lui donne l'appel
         comme sortie, au moment ou l'hesitation se produit. -->
    <p class="vehicules-aide mt-10">
      Vous ne savez pas quel véhicule choisir ?{' '}
      <a
        href={TEL_HREF}
        class="vehicules-aide-lien"
        aria-label={`Appeler Transport Événementiel Nantes au ${TEL_AFFICHE}`}
      >
        Appelez-nous
      </a>, on vous oriente en deux minutes.
    </p>
  </Section>

  <!-- 3. ZONE DESSERVIE : Nantes et Loire-Atlantique -->
  <Section id="zone-desservie" tone="cream-soft"></Section>

  <!-- 4. COMMENT CA MARCHE : de la demande au jour J -->
  <Section id="comment-ca-marche" tone="cream"></Section>

  <!-- 5. FAQ : questions de location, a baliser en FAQPage a l'etape contenu -->
  <Section id="faq" tone="cream-soft"></Section>

  <!-- 6. FORMULAIRE : demande de devis, conversion finale -->
  <Section id="formulaire-devis" tone="dark"></Section>

  <!-- Barre d'appel fixe, mobile uniquement. Prend le relais du CTA du hero
       des qu'il sort de l'ecran. Voir CallBar.astro pour les conditions
       d'affichage. -->
  <CallBar />
</Base>

<style>
  /* ============ HERO ============
     Ecrit mobile d'abord : les regles de base ciblent 375px, les media
     queries montent ensuite. 83 % du trafic arrive sur mobile.

     Aucune image, aucun degrade lourd : un halo radial en CSS pur donne de
     la profondeur sans une seule requete reseau. */

  .hero-glow {
    background:
      radial-gradient(
        ellipse 90% 60% at 15% 0%,
        rgba(42, 70, 54, 0.55) 0%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 70% 50% at 100% 100%,
        rgba(201, 162, 75, 0.1) 0%,
        transparent 65%
      );
  }

  /* H1. Pas de uppercase, contrairement au hero de l'accueil : le titre est
     long (57 caracteres) et la capitale ajoute environ 12 % de largeur, donc
     deux lignes de plus sur un ecran de 375px. En bas de casse il tient plus
     haut dans l'ecran et se lit plus vite, ce qui compte pour une audience
     de 45 a 65 ans. */
  .hero-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.95rem, 7vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--on-dark);
  }

  /* Sous-titre. Couleur posee en CSS et non via text-on-dark/[0.92] :
     l'opacite arbitraire de Tailwind ne produit aucune regle sur une
     variable non-RGB (verifie dans le CSS compile, la classe n'existe pas).
     Voir CLAUDE.md. */
  .hero-subtitle {
    font-family: var(--font-body);
    font-weight: 400;
    /* 17px minimum sur mobile, au-dessus du plancher de 16px demande. */
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--on-dark);
    opacity: 0.92;
  }

  /* ---- CTA 1 : appel telephonique, action dominante ----
     Pleine largeur sur mobile, hauteur 60px (le minimum demande etait 48px),
     numero a 1.5rem. C'est l'element le plus lourd visuellement de la page,
     volontairement. */
  .hero-cta-tel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    width: 100%;
    min-height: 60px;
    padding: 0.75rem 1.5rem;
    border-radius: 9999px;
    background-color: var(--gold);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 300ms var(--ease);
  }

  .hero-cta-tel-number {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 1.5rem;
    line-height: 1;
    letter-spacing: 0.01em;
    /* Le numero ne doit jamais se couper en deux lignes. */
    white-space: nowrap;
  }

  /* ---- CTA 2 : devis, secondaire ---- */
  .hero-cta-devis {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 52px;
    padding: 0.75rem 1.75rem;
    border-radius: 9999px;
    border: 1px solid var(--line-on-dark);
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 1rem;
    line-height: 1;
    color: var(--on-dark);
    text-decoration: none;
    transition:
      border-color 300ms var(--ease),
      background-color 300ms var(--ease);
  }

  /* ---- Reassurance ----
     Les trois arguments ne tiennent pas sur une ligne a 375px (environ 62
     caracteres pour 335px utiles). Plutot qu'une ligne a separateurs qui se
     casse n'importe ou, on empile en liste sur mobile, un point dore devant
     chaque item, et on revient a la ligne separee des 640px ou la place
     existe.

     Les puces sont en ::before : le point n'est ni lu par les lecteurs
     d'ecran, ni copie avec le texte. */
  .hero-reassurance {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--on-dark);
    opacity: 0.88;
  }

  .hero-reassurance li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hero-reassurance li::before {
    content: '';
    flex: none;
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background-color: var(--gold);
  }

  /* ---- A partir de 640px : les CTA passent cote a cote et se dimensionnent
       a leur contenu, la reassurance revient sur une seule ligne. ---- */
  @media (min-width: 640px) {
    .hero-cta-tel,
    .hero-cta-devis {
      width: auto;
    }

    .hero-reassurance {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.4rem 0.85rem;
    }

    /* En ligne, le premier item n'a pas de separateur devant lui. */
    .hero-reassurance li:first-child::before {
      display: none;
    }
  }

  /* Le hover n'existe pas sur mobile. On le reserve aux appareils qui
     pointent vraiment, pour eviter les etats colles au tap. */
  @media (hover: hover) {
    .hero-cta-tel:hover {
      background-color: var(--gold-soft);
    }
    .hero-cta-devis:hover {
      border-color: var(--gold);
      background-color: rgba(237, 231, 218, 0.06);
    }
  }

  /* ============ VEHICULES ============
     Aucune image disponible, et aucune image d'illustration : montrer un
     autocar qui n'est pas celui qu'on fournit poserait le meme probleme
     que d'ecrire "notre flotte". La capacite porte donc seule la charge
     visuelle, en typographie.

     Capacite au-dessus du texte, et non dans une colonne a gauche : la
     colonne testee ne laissait que 203px au descriptif a 375px, qui partait
     alors sur quatre lignes. En pleine largeur il tient sur deux, pour une
     hauteur de carte identique. A encombrement egal, on prend la version
     lisible.

     Pas de carrousel horizontal : il masque une partie de l'offre derriere
     un geste, et cette audience ne le fait pas. Les quatre capacites
     doivent etre lisibles d'un seul coup d'oeil. */

  .vehicules-eyebrow {
    color: var(--gold);
  }

  .vehicules-intro {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--ink-muted);
  }

  .vehicules-liste {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .vehicule {
    padding: 1.25rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background-color: var(--cream-soft);
  }

  /* Capacite sur une ligne, alignee sur la ligne de base : le nombre est
     trois fois plus gros que ce qui l'entoure, mais l'ensemble se lit
     quand meme comme une phrase, "jusqu'a 3 passagers". */
  .vehicule-capacite {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
  }

  .vehicule-prefixe,
  .vehicule-unite {
    font-family: var(--font-body);
    font-weight: 500;
    font-size: 0.9375rem;
    line-height: 1.2;
    color: var(--ink-muted);
  }

  .vehicule-nombre {
    color: var(--gold);
    /* Une capacite ne se coupe jamais en deux lignes, "15 a 22" comprise. */
    white-space: nowrap;
  }

  /* Une fourchette occupe six caracteres la ou un plafond en occupe un a
     trois. Sans ce cran en dessous, la ligne du minibus se casse dans la
     grille a deux colonnes. */
  .vehicule-nombre--plage {
    font-size: clamp(1.6rem, 3vw, 2.1rem);
  }

  .vehicule-nom {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.2;
    color: var(--ink);
  }

  .vehicule-description {
    margin-top: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  /* ---- Aide au choix ---- */
  .vehicules-aide {
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--ink);
  }

  /* Lien d'appel en plein texte. La cible est modeste, mais elle ne porte
     pas l'appel a elle seule : a ce niveau de scroll la barre d'appel fixe
     est affichee en bas de l'ecran, avec ses 56px de haut sur toute la
     largeur. Ce lien est un rappel dans le fil de la lecture, pas le
     dispositif principal. Souligne et dore : reconnaissable comme lien sans
     dependre de la seule couleur. */
  .vehicules-aide-lien {
    display: inline-block;
    padding: 0.15rem 0.1rem;
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--gold);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
    transition: color 300ms var(--ease);
  }

  @media (min-width: 640px) {
    /* Deux colonnes des que la place existe : la gamme se lit alors en un
       seul bloc, sans scroll. */
    .vehicules-liste {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .vehicule {
      padding: 1.5rem;
    }
  }

  @media (hover: hover) {
    .vehicules-aide-lien:hover {
      color: var(--gold);
    }
  }
</style>
