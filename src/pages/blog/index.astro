---
/*
  /blog : page index des ressources.
  Liste les articles de la collection blog, tries du plus recent au plus
  ancien, en grille responsive (aucun scroll horizontal). Reutilise le
  design system : header/footer, tone cream, Eyebrow, reveal en cascade.
*/
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getLang, useTranslations } from '../../i18n';

// Textes : src/i18n/<langue>.ts, cle `blog`. Le blog reste hors perimetre
// anglais (pas de /en/blog) : getLang renvoie donc toujours 'fr' ici.
const t = useTranslations(getLang(Astro.url)).blog;

// Tri anti-chronologique : le dernier article publie en premier.
const articles = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

---

<Base title={t.metaTitle} description={t.metaDescription} headerTheme="light">
  <section
    data-tone="cream"
    class="relative bg-cream py-section text-ink scroll-mt-24"
  >
    <div class="container">
      <!-- En-tete de la page ressources -->
      <div class="max-w-3xl" data-reveal-stagger="120">
        <div data-reveal>
          <Eyebrow tone="light">{t.eyebrow}</Eyebrow>
        </div>
        <h1 class="type-h2 mt-6 text-ink" data-reveal>{t.h1}</h1>
        <p class="type-body mt-6 max-w-[60ch] text-ink-muted" data-reveal>
          {t.intro}
        </p>
      </div>

      <!-- Grille d'articles. Une colonne mobile, deux tablette, trois desktop. -->
      {
        articles.length > 0 ? (
          <div
            class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 md:mt-16"
            data-reveal-stagger="120"
          >
            {articles.map((article) => (
              <ArticleCard
                slug={article.id}
                title={article.data.title}
                description={article.data.description}
                category={article.data.category}
                date={article.data.date}
                readingTime={article.data.readingTime}
              />
            ))}
          </div>
        ) : (
          <p class="type-body mt-14 text-ink-muted" data-reveal>
            {t.empty}
          </p>
        )
      }
    </div>
  </section>
</Base>
