---
/*
  Footer : fond vert profond, logo, liens, mentions, credit.
  Contenu minimal placeholder, sera enrichi plus tard.
*/
import { getLang, useTranslations } from '../i18n';

const year = new Date().getFullYear();

// Textes et liens : src/i18n/<langue>.ts, cle `footer`. Les liens d'ancre
// y sont prefixes par '/' pour rester cliquables depuis les pages blog.
const dict = useTranslations(getLang(Astro.url));
const t = dict.footer;
---

<footer class="border-t border-[var(--line-on-dark)] bg-green-900 text-on-dark">
  <div class="container py-16">
    <div class="grid gap-12 md:grid-cols-[1.4fr_repeat(3,1fr)]">
      <div>
        <a
          href={t.homeHref}
          class="footer-logo font-display font-medium tracking-tight"
          aria-label={dict.common.homeAria}
        >
          <span class="footer-logo-main">{t.logoMain}</span>
          <span class="footer-logo-sub">{t.logoSub}</span>
        </a>
        <p class="type-body mt-4 max-w-xs text-on-dark/[0.92]">
          {t.tagline}
        </p>
      </div>

      {
        t.columns.map((col) => (
          <nav aria-label={col.title}>
            <p class="type-eyebrow text-on-dark/[0.85]">{col.title}</p>
            <ul class="mt-5 space-y-3">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="type-nav text-on-dark/[0.92] transition-colors hover:text-gold"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="mt-14 flex flex-col gap-4 border-t border-[var(--line-on-dark)] pt-8 text-sm text-on-dark/[0.85] sm:flex-row sm:items-center sm:justify-between"
    >
      <p>&copy; {year} {t.copyright}</p>
      <div class="flex gap-6">
        {
          t.legalLinks.map((link) => (
            <a href={link.href} class="transition-colors hover:text-gold">
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>

<style>
  /* Logo pied de page : meme traitement compact deux lignes que le header. */
  .footer-logo {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .footer-logo-main {
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1.05;
  }
  .footer-logo-sub {
    font-weight: 500;
    font-size: 0.9rem;
    line-height: 1.1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold);
  }
</style>
