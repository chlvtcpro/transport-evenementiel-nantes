---
/*
  Bandeau de consentement (tarteaucitron.js) + Google Consent Mode v2.

  ---------------------------------------------------------------------
  BLOCAGE STRICT
  ---------------------------------------------------------------------
  Google Tag Manager n'est PAS charge tant que le visiteur n'a pas
  explicitement accepte. Aucun script googletagmanager.com n'est demande
  avant le clic. Trois garde-fous, volontairement redondants :

  1. `serviceDefaultState: 'wait'` : le service demarre en attente, ni
     autorise ni refuse.
  2. `highPrivacy: true` : pas de consentement implicite. Sans lui,
     tarteaucitron considere une simple navigation comme un accord et
     lance le service.
  3. `googleConsentMode: false` + `softConsentMode: true` : le `fallback`
     du service googletagmanager de tarteaucitron charge gtm.js meme sans
     consentement quand `googleConsentMode` est actif et `softConsentMode`
     faux (c'est le mode "advanced" de Google). Les deux valeurs ci-dessous
     neutralisent ce chemin. NE PAS LES INVERSER sans relire
     tarteaucitron.services.js, sinon GTM repart avant consentement.

  On renonce donc au Consent Mode integre de tarteaucitron, qui de toute
  facon ne cable ses `consent update` que sur les services `gtag`,
  `googleads` et `gcmads`, jamais sur `googletagmanager`. Le Consent Mode
  est reimplemente ci-dessous, explicitement.

  ---------------------------------------------------------------------
  ORDRE DES SIGNAUX DANS LE DATALAYER
  ---------------------------------------------------------------------
  L'ordre est ce qui rend le Consent Mode correct, il n'est pas cosmetique :

    consent default (tout denied)   <- script 1, avant toute autre chose
    consent update  (granted)       <- sur googletagmanager_consentModeOk
    gtm.start + chargement gtm.js   <- service.js() de tarteaucitron

  tarteaucitron emet `<service>_consentModeOk` AVANT d'executer le `js()`
  du service (voir userInterface.respond dans tarteaucitron.js). L'update
  est donc toujours dans la file avant que gtm.js ne soit demande : au
  chargement, GTM rejoue la file dans l'ordre et voit l'etat final. C'est
  le "basic consent mode" de Google.

  ---------------------------------------------------------------------
  ASSETS
  ---------------------------------------------------------------------
  La librairie est servie depuis /public/tarteaucitron (copie de
  node_modules/tarteaucitronjs, version minifiee). tarteaucitron deduit
  son propre chemin de base du `src` de son <script> : il ira chercher
  tout seul lang/tarteaucitron.fr.min.js, tarteaucitron.services.min.js
  et css/tarteaucitron.min.css a cote. Deplacer le dossier casse ces trois
  requetes. Pour mettre a jour : `npm update tarteaucitronjs` puis recopier
  les memes fichiers.
*/
interface Props {
  /** Identifiant du conteneur GTM, transmis par Base.astro. */
  gtmId: string;
}
const { gtmId } = Astro.props;
---

{/*
  1. Consent Mode v2. Doit s'executer avant tout le reste, d'ou is:inline
     (sans lui Astro en ferait un module differe, execute trop tard) et la
     position en tete du <head>.

     Tous les signaux soumis a consentement partent a 'denied'.
     `security_storage` est la seule exception et reste 'granted' : c'est
     le compartiment strictement necessaire (anti-fraude, securite), exempt
     de consentement au sens de l'article 82 de la loi Informatique et
     Libertes, et Google recommande de le laisser actif. Le passer a
     'denied' n'apporte rien juridiquement et degrade la protection
     anti-fraude.

     `wait_for_update` laisse 800 ms a un update pour arriver avant que les
     balises ne decident quoi faire.
*/}
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  window.gtagConsent = function gtagConsent() {
    window.dataLayer.push(arguments);
  };
  window.gtagConsent('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    functionality_storage: 'denied',
    personalization_storage: 'denied',
    security_storage: 'granted',
    wait_for_update: 800,
  });
</script>

{/*
  2. Librairie. Script classique, ni async ni defer : l'ordre d'execution
     avec le script d'init qui suit doit etre garanti.
*/}
<script is:inline src="/tarteaucitron/tarteaucitron.min.js"></script>

{/*
  3. Initialisation, declaration du service GTM et cablage du Consent Mode.
*/}
<script is:inline define:vars={{ gtmId }}>
  tarteaucitron.init({
    privacyUrl: '/confidentialite',
    readmoreLink: '/confidentialite',

    hashtag: '#consentement',
    cookieName: 'tec_consent',

    // Bandeau en bas, pleine largeur. Pas de modale bloquante : on informe
    // sans sequestrer, les deux choix sont accessibles immediatement.
    orientation: 'bottom',
    bodyPosition: 'top',

    // Les deux CTA de premier niveau. Obligatoires cote CNIL : refuser
    // doit couter exactement un clic, comme accepter.
    AcceptAllCta: true,
    DenyAllCta: true,

    // Pas de consentement implicite : ni la navigation ni le scroll ne
    // valent accord. Exigence CNIL.
    highPrivacy: true,

    // Rien n'est lance tant que le visiteur n'a pas tranche.
    serviceDefaultState: 'wait',

    // Voir le commentaire de tete : ces deux lignes sont ce qui empeche
    // GTM de se charger avant consentement.
    googleConsentMode: false,
    softConsentMode: true,

    // Pas de pastille flottante permanente : la reouverture des reglages
    // passe par le lien dedie de /confidentialite.
    showIcon: false,
    showAlertSmall: false,

    // Detail des services deplie au clic, liste de cookies masquee.
    showDetailsOnClick: true,
    cookieslist: false,
    groupServices: false,
    partnersList: false,

    // Le bandeau ne se ferme pas tout seul sur un clic exterieur : cela
    // pourrait passer pour un accord tacite.
    closePopup: false,
    mandatory: true,
    mandatoryCta: false,

    // DNT non gere : le signal est ambigu et peu diffuse. Le choix
    // explicite du visiteur fait foi.
    handleBrowserDNTRequest: false,
    removeCredit: true,
    moreInfoLink: true,
    adblocker: false,
    useExternalCss: false,
    useExternalJs: false,
  });

  // Service unique : le conteneur GTM. Tout ce qui est mesure d'audience
  // et suivi de conversion publicitaire passe par lui, c'est donc lui
  // qu'on soumet au consentement.
  tarteaucitron.user.googletagmanagerId = gtmId;
  (tarteaucitron.job = tarteaucitron.job || []).push('googletagmanager');

  // Accord : on passe les signaux a 'granted'. Emis avant service.js(),
  // donc avant gtm.start et avant le chargement de gtm.js.
  document.addEventListener('googletagmanager_consentModeOk', function () {
    window.gtagConsent('consent', 'update', {
      ad_storage: 'granted',
      ad_user_data: 'granted',
      ad_personalization: 'granted',
      analytics_storage: 'granted',
    });
  });

  // Refus, ou retrait du consentement depuis le panneau. On reaffirme
  // 'denied' : si GTM avait ete charge lors d'une visite precedente,
  // l'etat courant doit redescendre.
  document.addEventListener('googletagmanager_consentModeKo', function () {
    window.gtagConsent('consent', 'update', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
    });
  });
</script>

<style is:global>
  /* =========================================================
     Theme sombre tarteaucitron, aligne sur les tokens du site.

     tarteaucitron injecte sa feuille par <link> au moment de l'init,
     donc APRES ce bloc dans la cascade. On ne peut pas compter sur
     l'ordre : les declarations qui doivent gagner sont en !important,
     et les selecteurs reprennent le prefixe "html body" que la feuille
     d'origine utilise deja.
     ========================================================= */

  /* ---- Bandeau ---- */
  html body #tarteaucitronRoot #tarteaucitronAlertBig {
    background: var(--green-900) !important;
    color: var(--on-dark) !important;
    border-top: 1px solid var(--gold) !important;
    box-shadow: 0 -18px 50px rgba(0, 0, 0, 0.35) !important;
    font-family: var(--font-body) !important;
    padding: 1.5rem 1.25rem !important;
    text-align: center;
  }

  html body #tarteaucitronRoot #tarteaucitronDisclaimerAlert,
  html body #tarteaucitronRoot #tarteaucitronDisclaimerAlert strong {
    color: var(--on-dark) !important;
    font-family: var(--font-body) !important;
    font-size: 0.98rem !important;
    line-height: 1.65 !important;
    max-width: 62ch;
    margin: 0 auto 0.25rem !important;
    display: block;
  }

  /* ---- Les deux CTA de consentement ----
     Meme geometrie, meme typographie, meme contraste : "Tout refuser"
     n'est ni plus petit, ni plus pale, ni relegue. Seule la couleur de
     remplissage distingue les deux, et les deux sont pleines. Toute
     modification qui minorerait le refus casserait la conformite CNIL. */
  html body #tarteaucitronRoot #tarteaucitronAlertBig button.tarteaucitronCTAButton {
    font-family: var(--font-body) !important;
    font-size: 0.95rem !important;
    font-weight: 600 !important;
    line-height: 1 !important;
    letter-spacing: 0.01em !important;
    padding: 0.85rem 1.6rem !important;
    margin: 0.35rem 0.3rem !important;
    min-width: 11rem !important;
    border: 1px solid transparent !important;
    border-radius: 0.5rem !important;
    cursor: pointer !important;
    transition: filter 200ms var(--ease) !important;
    opacity: 1 !important;
    text-transform: none !important;
  }

  /* Accepter : dore plein, texte encre. */
  html body #tarteaucitronRoot #tarteaucitronAlertBig button#tarteaucitronPersonalize2 {
    background: var(--gold) !important;
    color: var(--green-900) !important;
    border-color: var(--gold) !important;
  }

  /* Refuser : creme plein, texte encre. Meme surface, meme poids visuel. */
  html body #tarteaucitronRoot #tarteaucitronAlertBig button#tarteaucitronAllDenied2 {
    background: var(--on-dark) !important;
    color: var(--green-900) !important;
    border-color: var(--on-dark) !important;
  }

  html body #tarteaucitronRoot #tarteaucitronAlertBig button.tarteaucitronCTAButton:hover,
  html body #tarteaucitronRoot #tarteaucitronAlertBig button.tarteaucitronCTAButton:focus-visible {
    filter: brightness(1.08) !important;
  }

  /* ---- "Personnaliser" ----
     Lien discret, mais c'est un acces aux reglages, pas un choix de
     consentement : le minorer ne pose pas de probleme de conformite. */
  html body #tarteaucitronRoot #tarteaucitronAlertBig button#tarteaucitronCloseAlert,
  html body #tarteaucitronRoot #tarteaucitronAlertBig button#tarteaucitronPrivacyUrl {
    background: transparent !important;
    color: var(--on-dark) !important;
    border: 0 !important;
    font-family: var(--font-body) !important;
    font-size: 0.88rem !important;
    font-weight: 500 !important;
    text-decoration: underline !important;
    text-underline-offset: 3px !important;
    padding: 0.6rem 0.9rem !important;
    margin: 0.35rem 0.2rem !important;
    opacity: 0.85 !important;
    cursor: pointer !important;
  }
  html body #tarteaucitronRoot #tarteaucitronAlertBig button#tarteaucitronCloseAlert:hover,
  html body #tarteaucitronRoot #tarteaucitronAlertBig button#tarteaucitronPrivacyUrl:hover {
    color: var(--gold) !important;
    opacity: 1 !important;
  }

  /* ---- Focus visible, navigation clavier ---- */
  html body #tarteaucitronRoot button:focus-visible,
  html body #tarteaucitronRoot a:focus-visible {
    outline: 2px solid var(--gold) !important;
    outline-offset: 2px !important;
  }

  /* ---- Panneau de reglages ---- */
  html body #tarteaucitronRoot #tarteaucitron {
    background: var(--green-900) !important;
    color: var(--on-dark) !important;
    font-family: var(--font-body) !important;
    border-radius: 0.75rem !important;
    border: 1px solid var(--line-on-dark) !important;
    overflow: hidden !important;
  }

  html body #tarteaucitronRoot #tarteaucitronServices .tarteaucitronMainLine,
  html body #tarteaucitronRoot #tarteaucitronInfo,
  html body #tarteaucitronRoot #tarteaucitronServices .tarteaucitronTitle {
    background: var(--green-800) !important;
    color: var(--on-dark) !important;
    border-color: var(--line-on-dark) !important;
  }

  html body #tarteaucitronRoot #tarteaucitronServices .tarteaucitronLine {
    background: var(--green-800) !important;
    border-left: 3px solid var(--gold) !important;
    border-bottom: 1px solid var(--line-on-dark) !important;
  }
  html body #tarteaucitronRoot #tarteaucitronServices .tarteaucitronLine:hover {
    background: var(--green-700) !important;
  }

  html body #tarteaucitronRoot #tarteaucitronServices .tarteaucitronName,
  html body #tarteaucitronRoot #tarteaucitronServices .tarteaucitronName a,
  html body #tarteaucitronRoot #tarteaucitronServices .tarteaucitronName b,
  html body #tarteaucitronRoot #tarteaucitronInfo,
  html body #tarteaucitronRoot #tarteaucitronInfo p,
  html body #tarteaucitronRoot #tarteaucitronInfo a {
    color: var(--on-dark) !important;
  }

  html body #tarteaucitronRoot #tarteaucitronClosePanel {
    background: var(--green-800) !important;
    color: var(--on-dark) !important;
    border-bottom: 1px solid var(--line-on-dark) !important;
    font-family: var(--font-body) !important;
  }

  /* Les blocs suivants sont blancs ou noirs dans la feuille d'origine, pensee
     pour un panneau clair. Sur fond vert ils donnaient soit des pavés blancs,
     soit du texte noir sur vert : illisible dans les deux cas. */

  /* Conteneur general : la couleur de base du panneau descend par heritage. */
  html body #tarteaucitronRoot #tarteaucitronServices,
  html body #tarteaucitronRoot #tarteaucitronServices ul,
  html body #tarteaucitronRoot #tarteaucitronServices li {
    color: var(--on-dark) !important;
  }

  /* Cadre blanc autour de la liste des categories, et barre du bouton
     Enregistrer. */
  html body #tarteaucitronRoot #tarteaucitronServices .tarteaucitronBorder,
  html body #tarteaucitronRoot #tarteaucitronSave {
    background: var(--green-900) !important;
    border-color: var(--line-on-dark) !important;
  }

  /* Titres du panneau : noirs a l'origine. */
  html body #tarteaucitronRoot .tarteaucitronH1,
  html body #tarteaucitronRoot .tarteaucitronH2,
  html body #tarteaucitronRoot .tarteaucitronH3 {
    color: var(--on-dark) !important;
    font-family: var(--font-display) !important;
  }

  /* En-tetes de categorie (« Cookies obligatoires », « APIs ») : rendus en
     boutons blancs par la feuille d'origine. */
  html body #tarteaucitronRoot #tarteaucitronServices .tarteaucitronTitle button {
    background: transparent !important;
    color: var(--on-dark) !important;
    font-family: var(--font-body) !important;
    font-weight: 600 !important;
  }

  /* Encarts explicatifs de chaque categorie. */
  html body #tarteaucitronRoot .tarteaucitronDetails,
  html body #tarteaucitronRoot .tarteaucitronInfoBox {
    background: var(--green-800) !important;
    color: var(--on-dark) !important;
    border: 1px solid var(--line-on-dark) !important;
  }

  /* Lien vers la politique, dans le panneau : discret, pas un pave blanc. */
  html body #tarteaucitronRoot #tarteaucitronPrivacyUrlDialog {
    background: transparent !important;
    color: var(--on-dark) !important;
    border: 1px solid var(--line-on-dark) !important;
    border-radius: 0.4rem !important;
    font-family: var(--font-body) !important;
    padding: 0.5rem 1rem !important;
  }
  html body #tarteaucitronRoot #tarteaucitronPrivacyUrlDialog:hover,
  html body #tarteaucitronRoot #tarteaucitronPrivacyUrlDialog:focus-visible {
    background: var(--green-700) !important;
  }

  /* Le « + » d'ouverture des categories est un glyphe de police, pas un trace
     en bordures : on ne touche qu'a la couleur. Lui poser un background-color
     le transforme en pave plein. */
  html body #tarteaucitronRoot .tarteaucitronPlus,
  html body #tarteaucitronRoot .tarteaucitronPlus::before,
  html body #tarteaucitronRoot .tarteaucitronPlus::after {
    color: var(--on-dark) !important;
    background: transparent !important;
  }

  /* Glyphes coche / croix : ils doivent suivre la couleur du bouton. */
  html body #tarteaucitronRoot .tarteaucitronCheck,
  html body #tarteaucitronRoot .tarteaucitronCross {
    color: inherit !important;
  }

  /* Descriptif du service et ligne « aucun cookie » : gris sombre a
     l'origine. */
  html body #tarteaucitronRoot .tarteaucitronListCookies,
  html body #tarteaucitronRoot #tarteaucitronNoServicesTitle,
  html body #tarteaucitronRoot .tarteaucitronLine .tarteaucitronName span {
    color: var(--on-dark) !important;
  }

  /* Boutons Autoriser / Interdire du panneau : meme taille, meme poids,
     meme logique de symetrie que les CTA du bandeau. */
  html body #tarteaucitronRoot .tarteaucitronAsk button,
  html body #tarteaucitronRoot #tarteaucitronServices button.tarteaucitronAllow,
  html body #tarteaucitronRoot #tarteaucitronServices button.tarteaucitronDeny {
    font-family: var(--font-body) !important;
    font-size: 0.85rem !important;
    font-weight: 600 !important;
    border-radius: 0.4rem !important;
    padding: 0.55rem 1rem !important;
    min-width: 8.5rem !important;
    opacity: 1 !important;
  }
  html body #tarteaucitronRoot button.tarteaucitronAllow {
    background: var(--gold) !important;
    color: var(--green-900) !important;
  }
  html body #tarteaucitronRoot button.tarteaucitronDeny {
    background: var(--on-dark) !important;
    color: var(--green-900) !important;
  }

  /* Etat courant du service : lisible sur fond sombre. */
  html body #tarteaucitronRoot .tarteaucitronIsAllowed .tarteaucitronStatus,
  html body #tarteaucitronRoot .tarteaucitronIsDenied .tarteaucitronStatus {
    color: var(--on-dark) !important;
    opacity: 0.9 !important;
  }

  /* Voile derriere le panneau. */
  html body.tarteaucitron-modal-open div#tarteaucitronRoot::before {
    background: rgba(20, 38, 28, 0.72) !important;
    backdrop-filter: blur(3px);
  }

  /* ---- Mobile : les CTA passent en pleine largeur, empiles, toujours
     de meme taille l'un que l'autre. ---- */
  @media (max-width: 600px) {
    html body #tarteaucitronRoot #tarteaucitronAlertBig button.tarteaucitronCTAButton {
      display: block !important;
      width: 100% !important;
      min-width: 0 !important;
      margin: 0.4rem 0 !important;
    }
  }

  /* ---- Respect de prefers-reduced-motion ---- */
  @media (prefers-reduced-motion: reduce) {
    html body #tarteaucitronRoot * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>
