    html body #tarteaucitronRoot #tarteaucitronAlertBig,
    html body #tarteaucitronRoot #tarteaucitronAlertBig * {
      box-sizing: border-box !important;
    }

    /* Trois rangees obtenues par retour a la ligne, sans toucher au DOM
       genere par la librairie : texte / les deux CTA / les deux acces. */
    html body #tarteaucitronRoot #tarteaucitronAlertBig {
      display: flex !important;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      /* Le budget vertical est serre : 12 + 12 de padding, 1 de bordure,
         42 de texte, 44 de CTA, 34 d'acces, plus deux gouttieres. A
         0.5rem le total sortait a 161px. */
      gap: 0.45rem;
      padding: 0.75rem 1rem !important;
    }

    /* Contrepartie obligatoire du !important ci-dessus. tarteaucitron
       ferme le bandeau en posant un style INLINE `display: none`
       (userInterface.css, voir tarteaucitron.min.js). Or une declaration
       !important venue d'une feuille l'emporte sur un style inline qui
       n'en a pas : sans cette regle, le bandeau ne se fermait plus. Il
       restait dans le flux, invisible parce que la librairie passe aussi
       l'opacite a 0, mais toujours cliquable, et il avalait les taps sur
       les 159 px de bas de page, CTA telephone compris.
       Ne pas retirer sans retirer aussi le !important sur display. */
    html body #tarteaucitronRoot #tarteaucitronAlertBig[style*='display: none'] {
      display: none !important;
    }

    /* Rangee 1 : le texte, pleine largeur. 15px, au-dessus du plancher
