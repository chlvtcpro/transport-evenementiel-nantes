  @media (max-width: 600px) {
    /* Le detail de la phrase. Voir alertBigPrivacy plus haut. */
    html body #tarteaucitronRoot #tarteaucitronAlertBig .tac-detail {
      display: none !important;
    }

    /* La feuille d'origine laisse ces elements en content-box. Avec
       width:100% et 20px de padding lateral, le bandeau mesurait 415px
       dans un viewport de 375 (40px hors ecran) et les boutons 433px.
