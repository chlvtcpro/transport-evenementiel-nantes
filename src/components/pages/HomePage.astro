---
/*
  Corps de la page d'accueil, partage par les deux langues.

  Les routes `src/pages/index.astro` (francais, racine) et
  `src/pages/en/index.astro` (anglais) se contentent de rendre ce composant :
  le contenu est identique, seule la langue change. Chaque section lit son
  texte dans src/i18n/<langue>.ts via getLang(Astro.url), la langue etant
  deduite du premier segment de l'URL. Aucune duplication de balisage entre
  les deux versions.

  Landing complete : hero, reassurance, process, offres, cas client,
  differenciateurs, FAQ, puis CTA final devis. Chaque section est un
  composant dedie, ancre par un id pour la navigation.
*/
import Base from '../../layouts/Base.astro';
import Hero from '../Hero.astro';
import Reassurance from '../Reassurance.astro';
import CommentCaMarche from '../CommentCaMarche.astro';
import Offres from '../Offres.astro';
import CasClient from '../CasClient.astro';
import Differenciateurs from '../Differenciateurs.astro';
import Faq from '../Faq.astro';
import Devis from '../Devis.astro';
---

<Base>
  <!-- 1. HERO -->
  <Hero />

  <!-- 2. REASSURANCE : bande logos clients, transition sombre depuis le hero -->
  <Reassurance />

  <!-- 3. COMMENT CA MARCHE : message de scalabilite + process 3 etapes -->
  <CommentCaMarche />

  <!-- 4. OFFRES : Seminaire (phare) / Mariage / Navette de groupe -->
  <Offres />

  <!-- 5. CAS CLIENT : cas phare nomme et chiffre + temoignages -->
  <CasClient />

  <!-- 6. DIFFERENCIATEURS : local et humain / bas-carbone / cle en main -->
  <Differenciateurs />

  <!-- 7. FAQ : vraies questions, reponses directes, balisees FAQPage -->
  <Faq />

  <!-- 8. DEVIS : CTA final de conversion -->
  <Devis />
</Base>
