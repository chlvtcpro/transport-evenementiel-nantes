---
/*
  Corps commun de la page de confirmation d'envoi du formulaire de devis,
  partage par les deux langues (/devis-envoye et /en/devis-envoye).

  Le visiteur n'arrive ici que par la redirection JS declenchee dans
  Devis.astro apres une reponse Web3Forms acceptee. La page est donc en
  robots noindex,follow : utile au visiteur, sans interet pour l'index.

  Meme grammaire visuelle que les pages legales : fond creme, header en
  variante claire, largeur de lecture contenue, reveal au scroll. La
  pastille de validation doree reprend le trait de l'ancien message de
  succes affiche en place dans le formulaire.
*/
import Base from '../../layouts/Base.astro';
import Eyebrow from '../Eyebrow.astro';
import { SITE_DATA } from '../../data/site.ts';
import { getLang, useTranslations } from '../../i18n';

// Textes : src/i18n/<langue>.ts, cle `devisEnvoye`.
const t = useTranslations(getLang(Astro.url)).devisEnvoye;
---

<Base
  title={`${t.metaTitle} | ${SITE_DATA.name}`}
  description={t.metaDescription}
  headerTheme="light"
  noindex={true}
>
  <section
    data-tone="cream"
    class="relative bg-cream py-section text-ink scroll-mt-24"
  >
    <div class="container">
      <div class="mx-auto max-w-[640px] text-center" data-reveal-stagger="120">
        <div class="flex justify-center" data-reveal>
          <span class="envoye-mark" aria-hidden="true"></span>
        </div>

        <div class="mt-8 flex justify-center" data-reveal>
          <Eyebrow tone="light">{t.eyebrow}</Eyebrow>
        </div>

        <h1 class="type-h2 mt-5 text-ink" data-reveal>{t.h1}</h1>

        <p class="type-body mt-6 text-ink-muted" data-reveal>{t.delai}</p>

        <p class="envoye-precision mt-4 text-ink-muted" data-reveal>
          {t.precision}
        </p>

        <div class="mt-12" data-reveal>
          <a
            href={t.homeHref}
            class="type-nav text-ink-muted transition-colors hover:text-gold"
          >
            {t.backHome}
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Pastille de validation : cercle fin dore, coche tracee en bordures.
     Reprise du motif de l'ancien bloc de succes du formulaire, retaillee
     pour une page entiere. */
  .envoye-mark {
    display: block;
    width: 3.75rem;
    height: 3.75rem;
    border-radius: 50%;
    border: 1px solid var(--gold);
    position: relative;
    flex-shrink: 0;
  }
  .envoye-mark::after {
    content: '';
    position: absolute;
    left: 1.35rem;
    top: 0.95rem;
    width: 0.8rem;
    height: 1.45rem;
    border-right: 2px solid var(--gold);
    border-bottom: 2px solid var(--gold);
    transform: rotate(45deg);
  }

  /* Precision secondaire : un cran sous le corps de texte. */
  .envoye-precision {
    font-family: var(--font-body);
    font-size: 0.95rem;
    line-height: 1.65;
  }
</style>
